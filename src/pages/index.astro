---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const projects = (await getCollection('projects')).sort((a,b) => a.data.order-b.data.order);
const featured = projects[0];
const moreProjects = projects.slice(1);
---
<BaseLayout title="Gennaro Basile — Engineer and AI builder" description="The personal website of Gennaro Basile: experience, software, hardware and Buildspace081.">
  <section id="intro" class="maker-surface flex min-h-[calc(100vh-4rem)] items-center py-16 sm:py-20"><div class="shell grid items-center gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-20"><div class="portrait-slot" aria-label="Reserved space for a future portrait photograph"><div><span class="eyebrow">Portrait</span><p class="mt-3 text-sm text-muted">Personal photograph coming soon.</p></div></div><div class="max-w-3xl"><p class="eyebrow mb-7">/ Intro</p><h1 class="intro-title">Hi, <span class="font-black">Gennaro</span> here.</h1><p class="body-copy mt-9">I’m a mechanical engineer and Data Science master’s student in Naples. I build software, explore machine learning and document the path toward AI engineering.</p><p class="mt-6 max-w-2xl text-lg leading-8 text-muted">After several years (2021–2025) in automotive validation between Italy and Michigan, I returned to Naples in 2025 to study Data Science at Federico II. <a href="/about" class="text-link">Read the full story →</a></p><div class="mt-10 flex flex-wrap gap-4"><a class="button button-primary" href="#software">See my work</a><a class="button" href="#experience">Experience</a></div></div></div></section>

  <section id="experience" class="content-section scroll-mt-20"><div class="shell"><div class="mx-auto max-w-2xl px-4 text-center sm:px-8"><p class="eyebrow">/ Experience</p><h2 class="mt-4 text-3xl font-extrabold tracking-[-.03em] sm:text-4xl">A career built before this one.</h2><p class="mx-auto mt-5 max-w-md text-base leading-7 text-muted">Four years across mechanical engineering and automotive validation (Ecoindustria, Maserati, Stellantis) taught me how physical systems fail and how evidence changes decisions—habits I now bring to Data Science.</p><a href="/about#experience" class="text-link mt-6 inline-block">See the full path →</a></div></div></section>

  <section id="software" class="content-section scroll-mt-20"><div class="shell"><div class="mb-12 flex flex-col gap-5 md:flex-row md:items-end md:justify-between"><div><p class="eyebrow">/ Software</p><h2 class="section-title mt-4">Things I build.</h2></div><a href="/projects" class="text-link">View all projects →</a></div>{featured && <article class="surface grid overflow-hidden lg:grid-cols-[.8fr_1.2fr]"><div class="relative flex min-h-72 items-end overflow-hidden border-b border-line p-7 lg:border-b-0 lg:border-r"><span class="absolute -right-4 -top-16 font-mono text-[13rem] leading-none opacity-10">01</span><div><p class="eyebrow">{featured.data.status}</p><h3 class="mt-3 text-5xl font-bold leading-none tracking-[-.055em]">{featured.data.title}</h3></div></div><div class="flex flex-col justify-between gap-12 p-7"><p class="body-copy">{featured.data.summary}</p><div><p class="mb-5 font-mono text-xs uppercase text-muted">{featured.data.topics.slice(0,2).join(' · ')}</p><a href={`/projects/${featured.id}/`} class="text-link">Open project →</a></div></div></article>}<div class="mt-5 grid gap-5 md:grid-cols-2">{moreProjects.map((project,index)=><article class="surface p-6"><p class="eyebrow">0{index+2} / {project.data.status}</p><h3 class="mt-6 text-3xl font-semibold tracking-[-.04em]">{project.data.title}</h3><p class="mt-4 text-lg leading-7 text-muted">{project.data.summary}</p><a href={`/projects/${project.id}/`} class="text-link mt-8 inline-block">Open project →</a></article>)}</div></div></section>

  <section id="hardware" class="content-section scroll-mt-20"><div class="shell grid gap-12 lg:grid-cols-[.7fr_1.3fr]"><div><p class="eyebrow">/ Hardware</p><h2 class="section-title mt-4">Back to physical things.</h2></div><div class="max-w-3xl"><p class="body-copy">Robotics is the bridge back to my mechanical-engineering roots: perception, control and software meeting the physical world.</p><div class="surface mt-10 p-6"><p class="eyebrow">Learning track · Coming soon</p><h3 class="mt-4 text-3xl font-semibold">Robotics Learning Log</h3><p class="mt-3 text-muted">Small builds will appear here when there is real hardware, code and a process worth documenting.</p><a href="/projects/robotics-log/" class="text-link mt-6 inline-block">View the roadmap →</a></div></div></div></section>

  <section id="buildspace081" class="content-section scroll-mt-20"><div class="shell grid gap-12 lg:grid-cols-[.6fr_1.4fr]"><div><p class="eyebrow">/ Community project</p><h2 class="section-title mt-4">Buildspace081</h2></div><div class="max-w-3xl"><p class="body-copy">A community in Naples for people who want to turn ideas into real projects. A few event photographs and founder stories can live here later as a glimpse into the community.</p><a href="https://buildspace081.com/" class="text-link mt-8 inline-block">Visit Buildspace081 ↗</a></div></div></section>
</BaseLayout>
