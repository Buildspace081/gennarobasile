---
const homeSections = [['/#about','About'],['/#experience','Experience'],['/#software','Software'],['/#hardware','Hardware'],['/#buildspace081','Buildspace081']];
const socialLinks = [
  ['mailto:gennarobasile13@gmail.com', 'Email', 'mail'],
  ['https://github.com/Buildspace081', 'GitHub', 'github'],
  ['https://www.linkedin.com/in/gennaro-basile-2149ab1b6/', 'LinkedIn', 'linkedin'],
  ['https://gennarobasile1.substack.com/', 'Substack', 'substack'],
] as const;
---
<header class="sticky top-0 z-40 border-b border-line bg-paper/95 backdrop-blur">
  <div class="shell flex min-h-16 items-center justify-between gap-6">
    <div class="flex items-center gap-8"><a href="/" class="whitespace-nowrap text-lg font-bold tracking-[-.045em]" aria-label="Gennaro Basile home">Gennaro Basile</a>
    <nav aria-label="Primary navigation" class="hidden items-center gap-5 lg:flex">
      {homeSections.map(([href,label]) => <a href={href} class="text-sm font-semibold text-muted hover:text-ink">{label}</a>)}
    </nav></div>
    <div class="flex items-center gap-2">
      {socialLinks.map(([href,label,icon]) => (
        <a
          href={href}
          aria-label={label}
          rel={href.startsWith('mailto:') ? undefined : 'me noopener'}
          target={href.startsWith('mailto:') ? undefined : '_blank'}
          class="social-icon"
        >
          {icon === 'mail' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6 8.5 7 8.5-7"/></svg>}
          {icon === 'github' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.2c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.46-1.19-1.11-1.51-1.11-1.51-.91-.64.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.9 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.72 0 0 .84-.27 2.75 1.05a9.3 9.3 0 0 1 5 0c1.9-1.32 2.74-1.05 2.74-1.05.56 1.41.2 2.46.1 2.72.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.2C22 6.58 17.52 2 12 2Z"/></svg>}
          {icon === 'linkedin' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zM9 9h3.83v1.64h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.77 2.65 4.77 6.1V21h-4v-5.6c0-1.34-.02-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.96V21H9z"/></svg>}
          {icon === 'substack' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20 14.5 9.5"/><path d="M13 6.5 17.5 11 20 8.5l-4.5-4.5z"/><path d="m4 20 2-5.5L14.5 6"/></svg>}
        </a>
      ))}
    <details class="relative lg:hidden">
      <summary class="cursor-pointer list-none border border-ink px-3 py-2 text-xs font-bold uppercase tracking-wide">Menu</summary>
      <nav aria-label="Mobile navigation" class="absolute right-0 top-12 flex w-56 flex-col border border-ink bg-paper p-3 shadow-[5px_5px_0_#e5e3ea]">
        {homeSections.map(([href,label]) => <a href={href} class="border-b border-line px-3 py-3 text-sm font-semibold">{label}</a>)}
      </nav>
    </details></div>
  </div>
</header>
