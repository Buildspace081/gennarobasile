---
const experiences = [
  { id: 'data-science', label: 'Data Science', eyebrow: 'Current · Naples', title: 'MSc in Data Science', organisation: 'University of Naples Federico II', copy: 'Building stronger foundations in statistics, machine learning and software while turning coursework into notebooks and projects.' },
  { id: 'automotive', label: 'Automotive', eyebrow: 'Previous chapter · Italy & Michigan', title: 'Automotive Validation Engineer', organisation: 'Engineering experience', copy: 'Working with complex physical systems taught me to investigate failures, test assumptions and make decisions from evidence.' },
  { id: 'buildspace', label: 'Buildspace081', eyebrow: 'Founder · Naples', title: 'Community builder', organisation: 'Buildspace081', copy: 'Creating a local environment where founders, engineers and curious people can meet and turn ideas into real projects.' },
];
---
<div class="experience-tabs grid gap-6 md:grid-cols-[12rem_1fr]" data-experience-tabs>
  <div role="tablist" aria-label="Experience" aria-orientation="vertical" class="flex gap-2 overflow-x-auto md:flex-col">
    {experiences.map((item,index) => <button type="button" id={`tab-${item.id}`} role="tab" aria-controls={`panel-${item.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-tab={item.id} class="whitespace-nowrap border-l-2 border-line px-4 py-3 text-left font-mono text-xs uppercase text-muted hover:text-ink aria-selected:border-orange aria-selected:bg-[#f5efe3] aria-selected:text-ink">{item.label}</button>)}
  </div>
  <div class="surface min-h-72 p-7">
    {experiences.map((item,index) => <article id={`panel-${item.id}`} role="tabpanel" aria-labelledby={`tab-${item.id}`} hidden={index !== 0} tabindex="0" data-panel={item.id}><p class="eyebrow text-purple">{item.eyebrow}</p><h3 class="mt-5 text-3xl font-semibold tracking-[-.04em]">{item.title}</h3><p class="mt-2 font-mono text-sm text-muted">{item.organisation}</p><p class="body-copy mt-8 max-w-2xl">{item.copy}</p></article>)}
  </div>
</div>
<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-experience-tabs]');
  roots.forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((candidate) => { const active = candidate === tab; candidate.setAttribute('aria-selected', String(active)); candidate.tabIndex = active ? 0 : -1; });
      panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== tab.dataset.tab; });
    };
    tabs.forEach((tab,index) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowDown','ArrowUp','ArrowRight','ArrowLeft','Home','End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (['ArrowDown','ArrowRight'].includes(event.key) ? 1 : -1) + tabs.length) % tabs.length;
        tabs[next].focus(); select(tabs[next]);
      });
    });
  });
</script>
