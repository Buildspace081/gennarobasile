---
interface Role { title: string; dateRange: string; points: string[]; learned?: string; }
interface Experience { id: string; label: string; eyebrow: string; title: string; organisation: string; dateRange: string; points: string[]; learned?: string; roles?: Role[]; }

const experiences: Experience[] = [
  { id: 'data-science', label: 'Data Science', eyebrow: 'Naples, Italy', title: 'MSc in Data Science', organisation: 'University of Naples Federico II', dateRange: '2025 – Present', points: ['Statistical learning, machine learning, big data systems and advanced programming.'], learned: 'Turning years of hands-on engineering judgement into rigorous statistical reasoning and code.' },
  { id: 'stellantis', label: 'Stellantis', eyebrow: 'Chelsea Proving Ground & Auburn Hills, USA', title: 'Powertrain Validation Engineer', organisation: 'Stellantis (via Teoresi Inc)', dateRange: 'Jan 2025 – Sep 2025', points: ['Designed and executed test campaigns for electric and hybrid vehicle systems.', 'Analyzed large volumes of performance data to diagnose issues and support engineering decisions.'], learned: 'How to turn large, messy validation datasets into clear, defensible engineering decisions under deadline pressure.', roles: [{ title: 'OBD Calibration Engineer', dateRange: 'Aug 2023 – Dec 2024', points: ['Owned end-to-end calibration projects for electrified powertrain systems.', 'Coordinated across multiple engineering disciplines to meet strict release deadlines.'], learned: 'How to own a technical project end to end and keep several disciplines aligned against one deadline.' }] },
  { id: 'maserati', label: 'Maserati', eyebrow: 'Modena, Italy', title: 'Design Release Engineer — Electronic Brake Module', organisation: 'Maserati (via Teoresi SpA)', dateRange: 'Mar 2022 – Aug 2023', points: ['Led the technical strategy for an electronic brake module.', 'Defined requirements and managed the full supplier relationship lifecycle from concept to production.'], learned: 'How to translate an ambiguous problem into a precise specification, then manage it through to production.' },
  { id: 'ecoindustria', label: 'Ecoindustria', eyebrow: 'Turin, Italy', title: 'Commissioning Engineer — Freight Cars', organisation: 'Ecoindustria Srl', dateRange: 'May 2021 – Nov 2021', points: ['Managed commissioning of freight rail vehicles.', 'Oversaw technical documentation and on-site testing for safety and performance standards.'], learned: 'How to verify a complex system methodically and document evidence so someone else can trust it.' },
  { id: 'mechanical-engineering', label: 'Mechanical Eng.', eyebrow: 'Naples, Italy', title: 'BSc in Mechanical Engineering', organisation: 'University of Naples Federico II', dateRange: '2020', points: ['Foundational training in mechanical systems, ahead of a move into automotive validation.'], learned: 'The fundamentals of how physical systems actually behave—the foundation everything after it was built on.' },
];
const defaultIndex = 0;
---
<div class="experience-tabs grid gap-10 md:grid-cols-[13rem_1fr]" data-experience-tabs>
  <div role="tablist" aria-label="Experience" aria-orientation="vertical" class="flex gap-1 overflow-x-auto md:flex-col">
    {experiences.map((item,index) => <button type="button" id={`tab-${item.id}`} role="tab" aria-controls={`panel-${item.id}`} aria-selected={index === defaultIndex ? 'true' : 'false'} tabindex={index === defaultIndex ? 0 : -1} data-tab={item.id} class="whitespace-nowrap border-l-2 border-line px-3 py-2 text-left text-sm text-muted hover:text-ink aria-selected:border-ink aria-selected:font-semibold aria-selected:text-ink">{item.label}</button>)}
  </div>
  <div class="min-h-72">
    {experiences.map((item,index) => <article id={`panel-${item.id}`} role="tabpanel" aria-labelledby={`tab-${item.id}`} hidden={index !== defaultIndex} tabindex="0" data-panel={item.id}>
      <h3 class="text-2xl font-bold tracking-[-.02em]">{item.title}</h3>
      <p class="mt-2 text-base font-semibold">{item.organisation}</p>
      <p class="mt-3 font-mono text-xs uppercase tracking-wide text-muted">{item.dateRange} · {item.eyebrow}</p>
      <ul class="mt-5 max-w-xl space-y-2.5 text-[.95rem] leading-relaxed">
        {item.points.map((point) => <li class="flex gap-3"><span class="mt-1 font-bold" aria-hidden="true">▸</span><span>{point}</span></li>)}
      </ul>
      {item.learned && <p class="mt-4 max-w-xl text-[.95rem] leading-relaxed"><strong class="font-bold">What I learned:</strong> {item.learned}</p>}
      {item.roles?.map((role) => (
        <div class="mt-6 max-w-xl border-t border-line pt-5">
          <h4 class="text-lg font-bold tracking-[-.01em]">{role.title}</h4>
          <p class="mt-2 font-mono text-xs uppercase tracking-wide text-muted">{role.dateRange}</p>
          <ul class="mt-3 space-y-2.5 text-[.95rem] leading-relaxed">
            {role.points.map((point) => <li class="flex gap-3"><span class="mt-1 font-bold" aria-hidden="true">▸</span><span>{point}</span></li>)}
          </ul>
          {role.learned && <p class="mt-4 text-[.95rem] leading-relaxed"><strong class="font-bold">What I learned:</strong> {role.learned}</p>}
        </div>
      ))}
    </article>)}
  </div>
</div>
<script>
  const roots = document.querySelectorAll<HTMLElement>('[data-experience-tabs]');
  roots.forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((candidate) => { const active = candidate === tab; candidate.setAttribute('aria-selected', String(active)); candidate.tabIndex = active ? 0 : -1; });
      panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== tab.dataset.tab; });
    };
    tabs.forEach((tab,index) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowDown','ArrowUp','ArrowRight','ArrowLeft','Home','End'].includes(event.key)) return;
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (['ArrowDown','ArrowRight'].includes(event.key) ? 1 : -1) + tabs.length) % tabs.length;
        tabs[next].focus(); select(tabs[next]);
      });
    });
  });
</script>
